# Server configuration
NODE_ENV=development
PORT=3000
HTTPS_PORT=3443
DB_PATH=app.db
UPLOADS_DIR=uploads

# Set to true to enable demo quick-login pills on the login screen
# and seed initial demo accounts/records on first start
DEMO_MODE=true
SEED_DEMO_RECORDS=true

# Optional bootstrap System admin password when DEMO_MODE=false
# ADMIN_INITIAL_PASSWORD=ChangeMeToAStrongPassword!

# Comma-separated list of extra allowed CORS origins (optional)
# CORS_ORIGINS=https://correspondence.example.com

# Reverse proxy trust (set to 1 behind Nginx/Caddy/Cloudflare)
TRUST_PROXY=0

# Optional TLS certificate paths (for direct Node HTTPS)
# SSL_KEY=certs/server.key
# SSL_CERT=certs/server.crt

# Optional Vercel Serverless Persistence (Turso libSQL + Vercel Blob)
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token
# BLOB_READ_WRITE_TOKEN=your-vercel-blob-rw-token

